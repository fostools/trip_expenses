{
  "name": "tripex",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp-native group trip expense splitter with receipt OCR and voice notes",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "simulate": "tsx src/simulate.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "receipt-password": "tsx src/tools/receipt-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
